# DataPilot AI - environment variables. Copy to .env

# REQUIRED: PostgreSQL connection string. Then run `npm run db:init` once.
DATABASE_URL="postgresql://user:password@localhost:5432/datapilot?schema=public"

# OPTIONAL (recommended): OpenRouter API key for real LLM intent extraction
# (src/lib/server/ai.ts). Get one at https://openrouter.ai/keys - the default
# model (x-ai/grok-4.1-fast:free) costs nothing. When empty, a deterministic
# local NLP fallback is used (offline-safe). Legacy name AI_API_KEY also works.
OPENROUTER_API_KEY=""
# Optional: override the model, e.g. "meta-llama/llama-3.3-70b-instruct:free"
# or "google/gemini-2.0-flash-001". Must be a valid OpenRouter model id.
AI_MODEL=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
