# DataPilot AI - environment variables. Copy to .env

# REQUIRED: PostgreSQL connection string. Then run `npm run db:init` once.
DATABASE_URL="postgresql://user:password@localhost:5432/datapilot?schema=public"

# OPTIONAL (recommended): NVIDIA NIM API key — preferred LLM for intent
# extraction (src/lib/server/ai.ts). Get a free key at https://build.nvidia.com
# (the same key also powers search-term expansion in crawler-service).
# When set, NIM is tried before OpenRouter. AI keys are server-only.
NVIDIA_API_KEY=""
# Optional: NIM model id (default meta/llama-3.1-70b-instruct)
NVIDIA_MODEL=""
# Optional: pin provider priority — "nvidia" or "openrouter". The other is still
# tried as a fallback, and the local NLP runs if every provider fails.
LLM_PROVIDER=""

# OPTIONAL: OpenRouter API key — fallback LLM for intent extraction.
# Get one at https://openrouter.ai/keys - the default model
# (x-ai/grok-4.1-fast:free) costs nothing. When both keys are empty, a
# deterministic local NLP fallback is used (offline-safe). Legacy name
# AI_API_KEY also works.
OPENROUTER_API_KEY=""
# Optional: override the OpenRouter model, e.g. "meta-llama/llama-3.3-70b-instruct:free"
# or "google/gemini-2.0-flash-001". Must be a valid OpenRouter model id.
AI_MODEL=""

# Live Crawler Service (Python FastAPI microservice)
# Runs on port 8001 by default. Set this to the service URL when deployed.
CRAWLER_SERVICE_URL="http://localhost:8001"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
